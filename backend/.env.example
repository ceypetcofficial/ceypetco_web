# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS - must be the deployed frontend origin (no trailing slash)
CLIENT_URL=https://dev.ceypetco.gov.lk

# MySQL
DB_HOST=your-plesk-mysql-host
DB_PORT=3306
DB_NAME=ceypetco_website
DB_USER=ceypetco_user
DB_PASSWORD=change_this_password
# Enable only when required by the MySQL provider.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Uploaded images and documents are stored in backend/uploads.
LOCAL_ASSET_BASE_URL=https://api-dev.ceypetco.gov.lk

# Optional: required only when deliberately running `npm run seed`.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
