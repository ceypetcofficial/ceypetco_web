# Server
PORT=5000
NODE_ENV=production

# CORS - must be the deployed frontend origin (no trailing slash)
CLIENT_URL=https://ceypetco.vercel.app

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ceypetco_website
DB_USER=ceypetco_user
DB_PASSWORD=change_this_password

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Uploaded images and documents are stored in backend/uploads.
LOCAL_ASSET_BASE_URL=https://api.example.com
