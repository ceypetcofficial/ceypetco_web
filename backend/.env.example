# Server
PORT=5000
NODE_ENV=production

# CORS - must be the deployed frontend origin (no trailing slash)
CLIENT_URL=https://ceypetco.vercel.app

# Microsoft SQL Server
SQL_SERVER=localhost\MSSQLSERVER2
SQL_DATABASE=CeypetcoWebsite
SQL_USER=sa
SQL_PASSWORD=change_this_password
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Uploaded images and documents are stored in backend/uploads.
LOCAL_ASSET_BASE_URL=http://localhost:5000
